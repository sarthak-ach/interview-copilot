{
  "manifest_version": 3,
  "name": "Interview Copilot Clipper",
  "version": "1.0",
  "description": "Scrapes job descriptions from LinkedIn and logs them to the Interview Copilot Job Tracker.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8080/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/jobs/*", "https://*.linkedin.com/jobs/view/*"],
      "js": ["content.js"]
    }
  ]
}
